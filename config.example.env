# Copy to .env and fill in. Every setting Norn reads is listed here.

# ── Required ──────────────────────────────────────────────────────

# The public address people use, with https://. Sign-in emails link here,
# and SvelteKit checks that form posts come from it.
ORIGIN=https://norn.example.com

# Who may sign in: addresses and/or @domains, separated by commas.
# Empty means nobody can sign in.
NORN_ALLOWED_EMAILS=you@example.com,@team.example.com

# Who creates projects and sees every board. They must also be allowed above.
NORN_ADMIN_EMAILS=you@example.com

# How sign-in emails are sent. smtp:// for STARTTLS (port 587),
# smtps:// for port 465. URL-encode special characters in the password.
NORN_SMTP_URL=smtp://user:password@smtp.example.com:587
NORN_MAIL_FROM=Norn <norn@example.com>

# ── Behind a reverse proxy ────────────────────────────────────────

# Which header carries the visitor's real address. Rate limits count per
# visitor, so without this every visitor looks like the proxy.
# Set it only when a proxy you control always sets the header.
ADDRESS_HEADER=X-Forwarded-For
# With X-Forwarded-For: how many proxies you run in front of Norn.
XFF_DEPTH=1

# ── Optional ──────────────────────────────────────────────────────

# Where the database lives. The Docker image uses /data/norn.db.
# NORN_DATABASE=./data/norn.db

# Pin the language for everyone (en or sv). Default: each visitor's browser.
# NORN_LANG=sv

# Print sign-in emails to the log instead of sending them. Only for trying
# Norn out: anyone who can read the log can sign in.
# NORN_MAIL_CONSOLE=true

# Port inside the container (Docker) or for `node build`.
# PORT=3000
